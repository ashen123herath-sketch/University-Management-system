@{
    ViewData["Title"] = "About";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="fw-bold mb-4">About UniManage</h2>
            <p class="lead">UniManage is a comprehensive University Course Management System designed to streamline academic operations.</p>
            
            <h4 class="mt-4">Our Mission</h4>
            <p>To provide an efficient, user-friendly platform that connects students, lecturers, and administrators in managing courses, assignments, and academic communications.</p>
            
            <h4 class="mt-4">Key Features</h4>
            <ul>
                <li>Role-based access for Students, Lecturers, and Administrators</li>
                <li>Comprehensive course management system</li>
                <li>Online assignment submission and grading</li>
                <li>Built-in communication system</li>
                <li>Advanced reporting and analytics</li>
            </ul>
        </div>
    </div>
</div>
