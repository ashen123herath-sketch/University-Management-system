@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="fw-bold mb-4">Privacy Policy</h2>
            <p class="text-muted">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
            
            <h4 class="mt-4">Information We Collect</h4>
            <p>We collect information you provide when registering and using UniManage, including name, email, and academic information.</p>
            
            <h4 class="mt-4">How We Use Your Information</h4>
            <p>Your information is used solely for academic management purposes within the university system.</p>
            
            <h4 class="mt-4">Data Security</h4>
            <p>We implement appropriate security measures to protect your personal information.</p>
        </div>
    </div>
</div>
