@model IEnumerable<Submission>
@{
    ViewData["Title"] = "All Submissions";
    var selectedAssignmentId = ViewBag.SelectedAssignmentId as int?;
    var selectedCourseId = ViewBag.SelectedCourseId as int?;
    var courses = ViewBag.Courses as List<Course>;
    var assignments = ViewBag.Assignments as List<Assignment>;
}

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold">
                <i class="bi bi-file-earmark-check"></i> All Assignment Submissions
            </h2>
            <p class="text-muted">View and manage all student submissions across courses</p>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-list-ul"></i> View Assignments
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Filter by Course:</label>
                    <select class="form-select" id="courseFilter" onchange="applyFilters()">
                        <option value="">All Courses</option>
                        @if (courses != null)
                        {
                            foreach (var course in courses)
                            {
                                <option value="@course.CourseId" selected="@(course.CourseId == selectedCourseId)">
                                    @course.CourseCode - @course.CourseName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Filter by Assignment:</label>
                    <select class="form-select" id="assignmentFilter" onchange="applyFilters()">
                        <option value="">All Assignments</option>
                        @if (assignments != null)
                        {
                            foreach (var a in assignments)
                            {
                                <option value="@a.AssignmentId" selected="@(a.AssignmentId == selectedAssignmentId)">
                                    @a.Title (@a.Course?.CourseCode)
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <a asp-action="AllSubmissions" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle"></i> Clear Filters
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Summary Stats -->
        <div class="row g-3 mb-4">
            @{
                var totalSubs = Model.Count();
                var gradedSubs = Model.Count(s => s.MarksObtained.HasValue);
                var withFiles = Model.Count(s => !string.IsNullOrEmpty(s.FilePath));
                var lateSubs = Model.Count(s => s.Status == "Late");
            }
            <div class="col-md-3">
                <div class="card text-center shadow-sm">
                    <div class="card-body py-3">
                        <h4 class="mb-0">@totalSubs</h4>
                        <small class="text-muted">Total Submissions</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center shadow-sm border-success">
                    <div class="card-body py-3">
                        <h4 class="mb-0 text-success">@gradedSubs</h4>
                        <small class="text-muted">Graded</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center shadow-sm border-primary">
                    <div class="card-body py-3">
                        <h4 class="mb-0 text-primary">@withFiles</h4>
                        <small class="text-muted">With File Uploads</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center shadow-sm border-danger">
                    <div class="card-body py-3">
                        <h4 class="mb-0 text-danger">@lateSubs</h4>
                        <small class="text-muted">Late Submissions</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Assignment</th>
                                <th>Course</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th>File</th>
                                <th>Comments</th>
                                <th>Grade</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var submission in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@submission.Student?.FullName</strong>
                                    </td>
                                    <td>
                                        <a asp-controller="Assignment" asp-action="Details"
                                           asp-route-id="@submission.AssignmentId"
                                           class="text-decoration-none">
                                            @submission.Assignment?.Title
                                        </a>
                                    </td>
                                    <td>
                                        <small class="text-muted">@submission.Assignment?.Course?.CourseCode</small><br />
                                        @submission.Assignment?.Course?.CourseName
                                    </td>
                                    <td>
                                        <small>@submission.SubmissionDate.ToString("MMM dd, yyyy")</small><br />
                                        <small class="text-muted">@submission.SubmissionDate.ToString("h:mm tt")</small>
                                    </td>
                                    <td>
                                        <span class="badge status-@submission.Status.ToLower()">@submission.Status</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(submission.FilePath))
                                        {
                                            <a asp-controller="Assignment" asp-action="DownloadSubmissionFile"
                                               asp-route-id="@submission.SubmissionId"
                                               class="btn btn-sm btn-success" title="Download submitted file">
                                                <i class="bi bi-download"></i> Download
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No file</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(submission.Comments))
                                        {
                                            <small class="text-muted" title="@submission.Comments">
                                                @(submission.Comments.Length > 40 ? submission.Comments.Substring(0, 40) + "..." : submission.Comments)
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (submission.MarksObtained.HasValue)
                                        {
                                            var pct = (submission.MarksObtained.Value / (submission.Assignment?.MaxMarks ?? 100)) * 100;
                                            var gc = pct >= 70 ? "success" : pct >= 50 ? "warning" : "danger";
                                            <span class="badge bg-@gc">
                                                @submission.MarksObtained / @submission.Assignment?.MaxMarks
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not Graded</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Assignment" asp-action="Grade"
                                           asp-route-id="@submission.SubmissionId"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil-square"></i> Grade
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #dee2e6;"></i>
                <h4 class="mt-3 text-muted">No Submissions Found</h4>
                <p class="text-muted">No student submissions match the selected filters.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function applyFilters() {
            const courseId = document.getElementById('courseFilter').value;
            const assignmentId = document.getElementById('assignmentFilter').value;
            let url = '@Url.Action("AllSubmissions")?';
            if (courseId) url += 'courseId=' + courseId + '&';
            if (assignmentId) url += 'assignmentId=' + assignmentId;
            window.location.href = url;
        }
    </script>
}
