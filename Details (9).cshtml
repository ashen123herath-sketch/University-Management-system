@model Message
@{
    ViewData["Title"] = "Message";
    var userId = Context.Session.GetInt32("UserId");
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@Model.Subject</h5>
                        <div>
                            @if (Model.ReceiverId == userId)
                            {
                                <a asp-action="Reply" asp-route-id="@Model.MessageId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-reply"></i> Reply
                                </a>
                            }
                            <form asp-action="Delete" asp-route-id="@Model.MessageId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                        onclick="return confirm('Delete this message?')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>From:</strong> @Model.Sender?.FullName (@Model.Sender?.Email)<br>
                        <strong>To:</strong> @Model.Receiver?.FullName (@Model.Receiver?.Email)<br>
                        <strong>Date:</strong> @Model.SentDate.ToString("MMMM dd, yyyy h:mm tt")
                    </div>
                    
                    <hr>
                    
                    <div class="message-body">
                        @Model.MessageBody
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Inbox
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
