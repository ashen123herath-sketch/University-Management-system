@model Course
@{
    ViewData["Title"] = "Course Details";
    var userRole = Context.Session.GetString("UserRole");
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">@Model.CourseName</h2>
            <p class="text-muted">@Model.CourseCode</p>
        </div>
        <div class="col-auto">
            @if (userRole == "Administrator")
            {
                <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            }
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Course Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="200">Course Code:</th>
                            <td>@Model.CourseCode</td>
                        </tr>
                        <tr>
                            <th>Department:</th>
                            <td>@Model.Department</td>
                        </tr>
                        <tr>
                            <th>Credits:</th>
                            <td>@Model.Credits</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.Semester))
                        {
                            <tr>
                                <th>Semester:</th>
                                <td>@Model.Semester</td>
                            </tr>
                        }
                        <tr>
                            <th>Lecturer:</th>
                            <td>@(Model.Lecturer?.FullName ?? "Not Assigned")</td>
                        </tr>
                        <tr>
                            <th>Max Students:</th>
                            <td>@Model.MaxStudents</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.Prerequisites))
                        {
                            <tr>
                                <th>Prerequisites:</th>
                                <td>@Model.Prerequisites</td>
                            </tr>
                        }
                    </table>
                    
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <h6 class="mt-4">Description</h6>
                        <p>@Model.Description</p>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="mb-3">Enrollment Status</h6>
                    @{
                        var enrolled = Model.Enrollments?.Count(e => e.Status == "Active") ?? 0;
                        var percentage = Model.MaxStudents > 0 ? (enrolled * 100.0 / Model.MaxStudents) : 0;
                    }
                    <h3 class="text-primary">@enrolled / @Model.MaxStudents</h3>
                    <div class="progress mb-2" style="height: 10px;">
                        <div class="progress-bar" style="width: @percentage%"></div>
                    </div>
                    <small class="text-muted">@percentage.ToString("F0")% Full</small>
                </div>
            </div>
            
            @if (Model.Assignments != null && Model.Assignments.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="mb-3">Assignments</h6>
                        <h3 class="text-success">@Model.Assignments.Count</h3>
                        <small class="text-muted">Total Assignments</small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
