@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6 mx-auto">
            <h2 class="fw-bold mb-4 text-center">Contact Us</h2>
            
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h5><i class="bi bi-geo-alt-fill text-primary"></i> Address</h5>
                    <p class="text-muted">University Campus<br>Academic Building, 3rd Floor<br>City, State 12345</p>
                    
                    <h5 class="mt-4"><i class="bi bi-envelope-fill text-primary"></i> Email</h5>
                    <p class="text-muted">support@unimanage.edu</p>
                    
                    <h5 class="mt-4"><i class="bi bi-telephone-fill text-primary"></i> Phone</h5>
                    <p class="text-muted">+1 (555) 123-4567</p>
                    
                    <h5 class="mt-4"><i class="bi bi-clock-fill text-primary"></i> Office Hours</h5>
                    <p class="text-muted">Monday - Friday: 9:00 AM - 5:00 PM</p>
                </div>
            </div>
        </div>
    </div>
</div>
