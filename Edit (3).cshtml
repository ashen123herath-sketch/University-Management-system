@model Course
@{
    ViewData["Title"] = "Update Course";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="fw-bold mb-4"><i class="bi bi-pencil-square"></i> Edit Course</h2>
            
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CourseId" />
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CourseCode" class="form-label fw-bold">Course Code *</label>
                                <input asp-for="CourseCode" class="form-control" readonly style="background-color: #e9ecef;" />
                                <small class="text-muted d-block">Course code cannot be changed</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CourseName" class="form-label fw-bold">Course Name *</label>
                                <input asp-for="CourseName" class="form-control" required />
                                <span asp-validation-for="CourseName" class="text-danger small"></span>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the course"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Department" class="form-label fw-bold">Department *</label>
                                <input asp-for="Department" class="form-control" required />
                                <span asp-validation-for="Department" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Semester" class="form-label fw-bold">Semester</label>
                                <select asp-for="Semester" class="form-select">
                                    <option value="">-- Select --</option>
                                    <option value="Fall 2026">Fall 2026</option>
                                    <option value="Spring 2027">Spring 2027</option>
                                    <option value="Summer 2027">Summer 2027</option>
                                    <option value="Fall 2027">Fall 2027</option>
                                    <option value="Spring 2028">Spring 2028</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Credits" class="form-label fw-bold">Credits *</label>
                                <input asp-for="Credits" type="number" class="form-control" min="1" max="10" required />
                                <span asp-validation-for="Credits" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MaxStudents" class="form-label fw-bold">Max Students *</label>
                                <input asp-for="MaxStudents" type="number" class="form-control" min="1" required />
                                <span asp-validation-for="MaxStudents" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="LecturerId" class="form-label fw-bold">Assign Lecturer</label>
                                <select asp-for="LecturerId" class="form-select">
                                    <option value="">-- Select Lecturer --</option>
                                    @foreach (var lecturer in ViewBag.Lecturers as List<User>)
                                    {
                                        <option value="@lecturer.UserId" selected="@(lecturer.UserId == Model.LecturerId)">
                                            @lecturer.FullName (@lecturer.Department)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Prerequisites" class="form-label fw-bold">Prerequisites</label>
                            <input asp-for="Prerequisites" class="form-control" placeholder="e.g., CS101, MATH201" />
                            <small class="text-muted">Comma-separated course codes</small>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Update Course
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}