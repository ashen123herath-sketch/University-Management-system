@model dynamic
@{
    ViewData["Title"] = "Assignment Analytics";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold"><i class="bi bi-file-earmark-text-fill"></i> Assignment Analytics</h2>
            <p class="text-muted">Assignment submission and grading statistics</p>
        </div>
    </div>

    <div class="col-auto">
        <a asp-action="ExportAssignmentAnalytics" asp-route-courseId="@ViewBag.SelectedCourseId" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <select name="courseId" class="form-select">
                        <option value="">All Courses</option>
                        @foreach (var course in ViewBag.Courses as List<Course>)
                        {
                            <option value="@course.CourseId">@course.CourseName (@course.CourseCode)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Assignment</th>
                                <th>Course</th>
                                <th>Due Date</th>
                                <th>Max Marks</th>
                                <th>Submissions</th>
                                <th>Graded</th>
                                <th>Avg Score</th>
                                <th>Late</th>
                                <th>Pending</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var completionRate = item.TotalSubmissions > 0 ? (item.GradedSubmissions * 100.0 / item.TotalSubmissions) : 0;
                                
                                <tr>
                                    <td><strong>@item.Assignment.Title</strong></td>
                                    <td>@item.Assignment.Course?.CourseName</td>
                                    <td>
                                        <small>@item.Assignment.DueDate.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td>@item.Assignment.MaxMarks</td>
                                    <td><span class="badge bg-primary">@item.TotalSubmissions</span></td>
                                    <td><span class="badge bg-success">@item.GradedSubmissions</span></td>
                                    <td>
                                        @if (item.AverageScore > 0)
                                        {
                                            var avgClass = item.AverageScore >= 70 ? "success" : item.AverageScore >= 50 ? "warning" : "danger";
                                            <span class="badge bg-@avgClass">@item.AverageScore.ToString("F1")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-warning">@item.LateSubmissions</span></td>
                                    <td><span class="badge bg-info">@item.PendingGrading</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No assignment data available.
        </div>
    }
    
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
    </div>
</div>
