@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6 mx-auto text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem;"></i>
            <h1 class="mt-4">Error</h1>
            <p class="lead text-muted">An error occurred while processing your request.</p>
            
            @if (Model?.ShowRequestId ?? false)
            {
                <p class="small text-muted">Request ID: @Model.RequestId</p>
            }
            
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-house"></i> Go Home
            </a>
        </div>
    </div>
</div>
