@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-graph-up"></i> Reports & Analytics</h2>
    
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-bar-chart-fill text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Course Popularity</h5>
                    <p class="text-muted">View enrollment statistics by course</p>
                    <a asp-action="CoursePopularity" class="btn btn-primary">View Report</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-trophy-fill text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Student Performance</h5>
                    <p class="text-muted">Analyze student grades and performance</p>
                    <a asp-action="StudentPerformance" class="btn btn-success">View Report</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-text-fill text-info" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Assignment Analytics</h5>
                    <p class="text-muted">Track assignment submissions and grades</p>
                    <a asp-action="AssignmentAnalytics" class="btn btn-info text-white">View Report</a>
                </div>
            </div>
        </div>
        
        @if (Context.Session.GetString("UserRole") == "Administrator")
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-people-fill text-warning" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Lecturer Workload</h5>
                        <p class="text-muted">View teaching assignments by lecturer</p>
                        <a asp-action="LecturerWorkload" class="btn btn-warning text-white">View Report</a>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-graph-up-arrow text-danger" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Enrollment Trends</h5>
                        <p class="text-muted">Analyze enrollment patterns over time</p>
                        <a asp-action="EnrollmentTrends" class="btn btn-danger">View Report</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
