@model dynamic
@{
    ViewData["Title"] = "Course Popularity Report";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold"><i class="bi bi-bar-chart-fill"></i> Course Popularity Report</h2>
            <p class="text-muted">Enrollment statistics by course</p>
        </div>
    </div>

    <div class="col-auto">
        <a asp-action="ExportCoursePopularity" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Code</th>
                                <th>Department</th>
                                <th>Lecturer</th>
                                <th>Active Enrollments</th>
                                <th>Completed</th>
                                <th>Dropped</th>
                                <th>Available Seats</th>
                                <th>Capacity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var percentFull = item.Course.MaxStudents > 0 ? (item.EnrollmentCount * 100.0 / item.Course.MaxStudents) : 0;
                                var statusClass = percentFull >= 90 ? "danger" : percentFull >= 70 ? "warning" : "success";
                                
                                <tr>
                                    <td><strong>@item.Course.CourseName</strong></td>
                                    <td>@item.Course.CourseCode</td>
                                    <td>@item.Course.Department</td>
                                    <td>@(item.Course.Lecturer?.FullName ?? "Not Assigned")</td>
                                    <td>
                                        <span class="badge bg-primary">@item.EnrollmentCount</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">@item.CompletedCount</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.DroppedCount</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusClass">@item.AvailableSeats</span>
                                    </td>
                                    <td>
                                        <div class="progress" style="width: 100px; height: 20px;">
                                            <div class="progress-bar bg-@statusClass" style="width: @percentFull%">
                                                @percentFull.ToString("F0")%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No course data available yet.
        </div>
    }
    
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
    </div>
</div>
